{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}La carte{% endblock %}

{#
   Une ligne de carte se déplace à la souris (ou au doigt) : l'ordre n'est plus
   un numéro à saisir. Glisser une ligne dans une autre catégorie la déplace.
   Les modifications s'enregistrent seules quand on quitte un champ.
#}

{% macro item_row(item) %}
  <li class="vv-builder__item" data-row data-id="{{ item.id }}">
    <div class="vv-builder__itemMain">
      <span class="vv-builder__handle" data-handle title="Glisser pour déplacer" aria-label="Déplacer">⠿</span>

      <input class="form-control form-control-sm vv-builder__name"
             data-field data-name
             value="{{ item.name }}"
             placeholder="Nom">

      <input class="form-control form-control-sm vv-builder__unit"
             data-field data-unit
             value="{{ item.unit ?? '' }}"
             placeholder="Unité">

      <input class="form-control form-control-sm vv-builder__price"
             data-field data-price
             value="{{ item.price ?? '' }}"
             placeholder="Prix">

      <input class="form-control form-control-sm vv-builder__note"
             data-field data-note
             value="{{ item.note ?? '' }}"
             placeholder="Note">

      <label class="vv-builder__publish" title="Visible sur le site">
        <input class="form-check-input" type="checkbox" data-field data-published {{ item.isPublished ? 'checked' : '' }}>
        <span class="visually-hidden">Visible sur le site</span>
      </label>

      <button class="btn btn-sm btn-link text-muted" type="button" data-add-variant title="Ajouter une déclinaison">+ décl.</button>
      <button class="btn btn-sm btn-link text-danger" type="button" data-delete title="Supprimer">✕</button>

      {# Doit rester avant les déclinaisons : le statut d'une ligne est le premier trouvé. #}
      <span class="vv-builder__status" data-status></span>
    </div>

    <ul class="vv-builder__variants" data-variants>
      {% for variant in item.variants %}
        <li class="vv-builder__variant" data-variant-row data-id="{{ variant.id }}" data-item-id="{{ item.id }}">
          <span class="vv-builder__variantMark" aria-hidden="true">↳</span>
          <input class="form-control form-control-sm" data-field data-variant-label
                 value="{{ variant.label }}" placeholder="Déclinaison">
          <input class="form-control form-control-sm" data-field data-variant-price
                 value="{{ variant.price ?? '' }}" placeholder="Prix">
          <button class="btn btn-sm btn-link text-danger" type="button" data-variant-delete title="Supprimer">✕</button>
          <span class="vv-builder__status" data-status></span>
        </li>
      {% endfor %}
    </ul>
  </li>
{% endmacro %}

{% macro category_items(category, itemsByCategory) %}
  {% import _self as builder %}
  {% set items = itemsByCategory[category.id] ?? [] %}

  <ul class="vv-builder__items" data-items data-category-id="{{ category.id }}">
    {% for item in items %}
      {{ builder.item_row(item) }}
    {% endfor %}
  </ul>

  <p class="vv-builder__empty" data-empty {{ items|length ? 'hidden' : '' }}>
    Aucune ligne — glisses-en une ici, ou ajoute-la ci-dessous.
  </p>

  <form class="vv-builder__add" data-item-create data-category-id="{{ category.id }}">
    <input class="form-control form-control-sm" name="name" placeholder="Nouvelle ligne (ex : Café expresso)" required>
    <input class="form-control form-control-sm" name="unit" placeholder="Unité">
    <input class="form-control form-control-sm" name="price" placeholder="Prix">
    <button class="btn btn-sm btn-outline-primary" type="submit">+ Ajouter</button>
    <span class="vv-builder__status" data-status></span>
  </form>
{% endmacro %}

{% block page_content %}
{% import _self as builder %}

<div class="vv-builder"
     data-menu-builder
     data-token="{{ csrf_token('menu_builder') }}"
     data-routes="{{ {
         itemCreate:      path('admin_menu_item_create'),
         itemUpdate:      path('admin_menu_item_update'),
         itemDelete:      path('admin_menu_item_delete'),
         itemReorder:     path('admin_menu_item_reorder'),
         categoryCreate:  path('admin_menu_category_create'),
         categoryReorder: path('admin_menu_category_reorder'),
         variantCreate:   path('admin_menu_variant_create'),
         variantUpdate:   path('admin_menu_variant_update'),
         variantDelete:   path('admin_menu_variant_delete')
     }|json_encode }}">

  <div class="vv-builder__intro">
    <p class="mb-1">
      Glisse les lignes avec la poignée <span class="vv-builder__handle">⠿</span> pour changer leur ordre,
      ou fais-les passer d'une catégorie à l'autre. Tout s'enregistre automatiquement.
    </p>
    <span class="vv-builder__status" data-global-status></span>
  </div>

  <form class="vv-builder__addCategory" data-cat-create>
    <input class="form-control" name="name" placeholder="Nouvelle catégorie" required>
    <select class="form-select" name="parentId">
      <option value="">Catégorie principale</option>
      {% for category in rootCategories %}
        <option value="{{ category.id }}">Dans « {{ category.name }} »</option>
      {% endfor %}
    </select>
    <button class="btn btn-primary" type="submit">+ Ajouter</button>
  </form>

  <ul class="vv-builder__roots" data-categories data-level="root" data-parent-id="">
    {% for category in rootCategories %}
      <li class="vv-builder__root" data-category data-id="{{ category.id }}">
        <div class="vv-builder__rootHead">
          <span class="vv-builder__handle" data-category-handle title="Glisser pour réordonner">⠿</span>
          <h3 class="vv-builder__rootName">{{ category.name }}</h3>
          {% if not category.isPublished %}<span class="badge bg-secondary">masquée</span>{% endif %}
          <span class="vv-builder__status" data-status></span>
        </div>

        {{ builder.category_items(category, itemsByCategory) }}

        <ul class="vv-builder__children" data-categories data-level="child" data-parent-id="{{ category.id }}">
          {% for child in category.children %}
            <li class="vv-builder__child" data-category data-id="{{ child.id }}">
              <div class="vv-builder__childHead">
                <span class="vv-builder__handle" data-category-handle title="Glisser pour réordonner">⠿</span>
                <h4 class="vv-builder__childName">{{ child.name }}</h4>
                {% if not child.isPublished %}<span class="badge bg-secondary">masquée</span>{% endif %}
                <span class="vv-builder__status" data-status></span>
              </div>

              {{ builder.category_items(child, itemsByCategory) }}
            </li>
          {% endfor %}
        </ul>
      </li>
    {% endfor %}
  </ul>
</div>

<style>
  /* Mise en page du builder — s'appuie sur les composants Bootstrap d'EasyAdmin,
     n'introduit pas de nouveau système de style. */
  .vv-builder__intro { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .vv-builder__addCategory { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem; max-width: 640px; }

  .vv-builder__roots, .vv-builder__children, .vv-builder__items, .vv-builder__variants {
    list-style: none; margin: 0; padding: 0;
  }

  /* Catégorie principale : bandeau plein, pour qu'elle se distingue nettement
     de ses sous-catégories et de ses lignes. */
  .vv-builder__root {
    background: #fff;
    border: 1px solid #c3cfcc;
    border-radius: .5rem;
    padding: 0 1rem 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 3px rgba(20, 45, 40, .08);
  }
  .vv-builder__rootHead {
    display: flex; align-items: center; gap: .5rem;
    background: #2d685f;
    margin: 0 -1rem 1rem;
    padding: .65rem 1rem;
    border-radius: .45rem .45rem 0 0;
  }
  .vv-builder__rootName { font-size: 1.15rem; font-weight: 700; margin: 0; color: #fff; letter-spacing: .01em; }
  .vv-builder__rootHead .vv-builder__handle { color: rgba(255, 255, 255, .75); }
  /* Le statut hérite des classes Bootstrap (text-success, text-muted…) qui
     seraient illisibles sur le bandeau : on force le blanc. */
  .vv-builder__rootHead .vv-builder__status,
  .vv-builder__rootHead .vv-builder__status * { color: #fff !important; }

  /* Sous-catégorie : même couleur, en retrait. */
  .vv-builder__childHead { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  .vv-builder__childName { font-size: 1rem; font-weight: 700; margin: 0; color: #2d685f; }
  .vv-builder__child { border-left: 3px solid #9dbdb6; padding: .5rem 0 .5rem .75rem; margin: 1rem 0 0 .5rem; }

  .vv-builder__item { padding: .2rem 0; }
  .vv-builder__itemMain { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .vv-builder__name { flex: 2 1 200px; }
  .vv-builder__unit, .vv-builder__price { flex: 0 1 90px; }
  .vv-builder__note { flex: 1 1 140px; }
  .vv-builder__publish { display: inline-flex; align-items: center; margin: 0; }

  .vv-builder__variant { display: flex; align-items: center; gap: .4rem; padding: .2rem 0 .2rem 2rem; }
  .vv-builder__variant input { max-width: 200px; }
  .vv-builder__variantMark { color: #adb5bd; }

  .vv-builder__handle { cursor: grab; color: #7d8a87; user-select: none; padding: 0 .15rem; }
  .vv-builder__handle:active { cursor: grabbing; }

  .vv-builder__empty { color: #6c757d; font-size: .875rem; font-style: italic; margin: .25rem 0 .5rem 1.6rem; }
  .vv-builder__add { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin: .5rem 0 0 1.6rem; }
  .vv-builder__add input { max-width: 200px; }

  .vv-builder__status { font-size: .8rem; min-width: 6rem; }

  .vv-sortable-ghost { opacity: .4; background: #e7f1ff; }
</style>
{% endblock %}
