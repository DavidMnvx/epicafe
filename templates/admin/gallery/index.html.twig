{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Les photos{% endblock %}

{% block page_content %}

<div class="vv-gal"
     data-gallery
     data-token="{{ csrf_token('gallery') }}"
     data-base-path="{{ asset('uploads/gallery') }}"
     data-routes="{{ {
         upload:  path('admin_gallery_upload_files'),
         reorder: path('admin_gallery_reorder'),
         update:  path('admin_gallery_update'),
         delete:  path('admin_gallery_delete')
     }|json_encode }}">

  {# ---------- Dépôt de fichiers ---------- #}
  <div class="vv-gal__drop" data-dropzone tabindex="0" role="button"
       aria-label="Ajouter des photos">
    <input type="file" multiple accept="image/*,application/pdf" hidden data-file-input>

    <div class="vv-gal__dropInner">
      <span class="vv-gal__dropIcon" aria-hidden="true">🖼️</span>
      <p class="vv-gal__dropTitle">Glisse tes photos ici</p>
      <p class="vv-gal__dropHint">
        ou clique pour les choisir — JPG, PNG, WebP et PDF acceptés.<br>
        Rien n’est publié avant que tu valides.
      </p>
    </div>
  </div>

  {# ---------- Modale de validation avant envoi ---------- #}
  <dialog class="vv-gal__modal" data-upload-modal>
    <form data-upload-form>
      <h2 class="vv-gal__modalTitle" data-modal-title>Ajouter des photos</h2>

      <div class="vv-gal__modalDate">
        <label for="vv-taken-at">Date de prise de vue</label>
        <input type="date" id="vv-taken-at" class="form-control form-control-sm" data-taken-at>
        <span class="vv-gal__hint">Commune au lot — elle range les photos dans leur mois. Facultative.</span>
      </div>

      <ul class="vv-gal__modalList" data-modal-list></ul>

      <footer class="vv-gal__modalActions">
        <button type="button" class="btn btn-link" data-modal-cancel>Annuler</button>
        <button type="submit" class="btn btn-primary" data-modal-submit>Ajouter</button>
      </footer>
    </form>
  </dialog>

  <div class="vv-gal__progress" data-progress hidden>
    <div class="vv-gal__progressBar"><span data-progress-bar></span></div>
    <p class="vv-gal__progressText" data-progress-text></p>
  </div>

  <div class="vv-gal__errors" data-errors hidden></div>

  {# ---------- Photos par mois ---------- #}
  <div class="vv-gal__count">
    <strong data-total>{{ total }}</strong> photo{{ total > 1 ? 's' : '' }} dans la galerie
    <span class="vv-gal__status" data-global-status></span>
  </div>

  {# Seul le mois en cours arrive déplié — à défaut, le plus récent. #}
  {% set currentMonth = 'now'|date('Y-m') %}
  {% set hasCurrent = currentMonth in months|keys %}

  <div data-months>
    {% for key, month in months %}
      {% set isOpen = key == currentMonth or (not hasCurrent and loop.first) %}
      <section class="vv-gal__month" data-month="{{ key }}">
        <button class="vv-gal__monthHead" type="button" data-month-toggle aria-expanded="{{ isOpen ? 'true' : 'false' }}">
          <span class="vv-gal__chevron" aria-hidden="true">▾</span>
          <span class="vv-gal__monthName">{{ month.label }}</span>
          <span class="vv-gal__monthCount" data-month-count>{{ month.photos|length }}</span>
        </button>

        <ul class="vv-gal__grid" data-photos {{ isOpen ? '' : 'hidden' }}
          {% for photo in month.photos %}
            <li class="vv-gal__tile{{ photo.isPublished ? '' : ' is-hidden' }}" data-photo data-id="{{ photo.id }}">
              <div class="vv-gal__thumb">
                <img src="{{ asset('uploads/gallery/' ~ photo.fileName) }}"
                     alt="{{ photo.title|e }}"
                     loading="lazy"
                     decoding="async">

                <span class="vv-gal__handle" data-handle title="Glisser pour réordonner" aria-hidden="true">⠿</span>

                {% if not photo.isPublished %}
                  <span class="vv-gal__badge" data-hidden-badge>Masquée</span>
                {% endif %}
              </div>

              <input class="form-control form-control-sm vv-gal__title"
                     data-title value="{{ photo.title }}" placeholder="Sans titre">

              <div class="vv-gal__tileActions">
                <button class="btn btn-sm btn-link" type="button" data-toggle-published>
                  {{ photo.isPublished ? 'Masquer' : 'Afficher' }}
                </button>
                <button class="btn btn-sm btn-link text-danger" type="button" data-delete>Supprimer</button>
                <span class="vv-gal__status" data-status></span>
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <p class="vv-gal__empty" data-empty-gallery>
        Aucune photo pour l’instant — dépose tes premières images ci-dessus.
      </p>
    {% endfor %}
  </div>
</div>

<style>
  /* S'appuie sur les composants Bootstrap d'EasyAdmin. */
  .vv-gal { max-width: 1100px; }

  .vv-gal__drop {
    border: 2px dashed #9dbdb6;
    border-radius: .6rem;
    background: #f7faf9;
    padding: 1.75rem 1.25rem;
    text-align: center;
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease;
  }
  .vv-gal__drop:hover, .vv-gal__drop:focus-visible { border-color: #2d685f; background: #eef5f3; }
  .vv-gal__drop.is-dragover { border-color: #2d685f; background: #e3efec; border-style: solid; }

  .vv-gal__dropIcon { font-size: 1.75rem; display: block; }
  .vv-gal__dropTitle { font-weight: 700; color: #2d685f; margin: .4rem 0 .2rem; font-size: 1.05rem; }
  .vv-gal__dropHint { color: #55606d; font-size: .85rem; margin: 0; }

  .vv-gal__dropDate {
    margin-top: 1rem; padding-top: .9rem; border-top: 1px solid #dfe8e6;
    display: flex; align-items: center; justify-content: center; gap: .6rem; flex-wrap: wrap;
  }
  .vv-gal__dropDate label { font-size: .85rem; color: #55606d; margin: 0; }
  .vv-gal__dropDate input { max-width: 170px; }
  .vv-gal__hint { font-size: .78rem; color: #8a9199; }

  .vv-gal__progress { margin-top: 1rem; }
  .vv-gal__progressBar { height: 6px; background: #e3efec; border-radius: 3px; overflow: hidden; }
  .vv-gal__progressBar span { display: block; height: 100%; width: 0; background: #2d685f; transition: width .2s ease; }
  .vv-gal__progressText { font-size: .85rem; color: #55606d; margin: .4rem 0 0; }

  .vv-gal__errors { margin-top: 1rem; }

  .vv-gal__count { margin: 1.5rem 0 .75rem; color: #55606d; display: flex; align-items: center; gap: .75rem; }

  .vv-gal__month { margin-bottom: 1.25rem; border: 1px solid #c3cfcc; border-radius: .5rem; overflow: hidden; }
  .vv-gal__monthHead {
    width: 100%; display: flex; align-items: center; gap: .6rem;
    background: #2d685f; color: #fff; border: 0;
    padding: .65rem 1rem; font-size: 1.05rem; font-weight: 700; text-align: left;
  }
  .vv-gal__monthCount {
    margin-left: auto; background: rgba(255,255,255,.2);
    border-radius: 999px; padding: .05rem .55rem; font-size: .85rem; font-weight: 600;
  }
  .vv-gal__chevron { transition: transform .18s ease; display: inline-block; }
  .vv-gal__monthHead[aria-expanded="false"] .vv-gal__chevron { transform: rotate(-90deg); }

  .vv-gal__grid {
    list-style: none; margin: 0; padding: 1rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1rem;
  }
  .vv-gal__grid[hidden] { display: none; }

  .vv-gal__tile { display: flex; flex-direction: column; gap: .4rem; }
  .vv-gal__tile.is-hidden .vv-gal__thumb img { opacity: .45; filter: grayscale(.5); }

  .vv-gal__thumb {
    position: relative; aspect-ratio: 4 / 3; border-radius: .4rem; overflow: hidden;
    background: #eef1f0; border: 1px solid #dfe8e6;
  }
  .vv-gal__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .vv-gal__handle {
    position: absolute; top: .35rem; left: .35rem;
    background: rgba(255,255,255,.92); color: #55606d;
    border-radius: .3rem; padding: .05rem .35rem; cursor: grab; user-select: none;
  }
  .vv-gal__handle:active { cursor: grabbing; }

  .vv-gal__badge {
    position: absolute; bottom: .35rem; right: .35rem;
    background: rgba(33,29,24,.82); color: #fff;
    font-size: .72rem; border-radius: .3rem; padding: .1rem .4rem;
  }

  .vv-gal__tileActions { display: flex; align-items: center; gap: .4rem; }
  .vv-gal__status { font-size: .78rem; min-width: 4rem; }

  /* Boutons des tuiles : de vrais boutons lisibles, pas des liens gris. */
  .vv-gal__tileActions [data-toggle-published],
  .vv-gal__tileActions [data-delete] {
    font-size: .8rem; font-weight: 600; line-height: 1;
    padding: .3rem .55rem; border-radius: .35rem;
    text-decoration: none; transition: background .15s ease, color .15s ease;
  }
  .vv-gal__tileActions [data-toggle-published] {
    color: #2d685f; border: 1px solid #9dbdb6; background: #fff;
  }
  .vv-gal__tileActions [data-toggle-published]:hover {
    background: #2d685f; color: #fff; border-color: #2d685f;
  }
  .vv-gal__tileActions [data-delete] {
    color: #b03526; border: 1px solid #dcb0a9; background: #fff;
  }
  .vv-gal__tileActions [data-delete]:hover {
    background: #fdf1ef; border-color: #b03526;
  }

  .vv-gal__empty { color: #6c757d; font-style: italic; padding: 1.5rem 0; }

  .vv-sortable-ghost { opacity: .4; }

  /* Confirmation de suppression intégrée au bouton (pas de popup navigateur). */
  .vv-gal__tileActions [data-delete].is-confirming,
  .vv-gal__tileActions [data-delete].is-confirming:hover {
    background: #c0392b; color: #fff; border-color: #c0392b;
  }

  /* ---------- Modale de validation ---------- */
  /* Un fond explicite partout : le <dialog> hérite sinon des couleurs du mode
     sombre d'EasyAdmin, et le voile par défaut est un noir massif. Ici, voile
     clair légèrement teinté + flou, dans la palette crème/vert du site. */
  .vv-gal__modal {
    border: 1px solid #c3cfcc; border-radius: .6rem; padding: 0;
    width: min(680px, calc(100vw - 2rem));
    background: #fff; color: #211d18;
    box-shadow: 0 18px 60px rgba(20, 45, 40, .22);
  }
  .vv-gal__modal::backdrop {
    background: rgba(239, 230, 220, .55);
    backdrop-filter: blur(5px) saturate(120%);
    -webkit-backdrop-filter: blur(5px) saturate(120%);
  }
  .vv-gal__modal form { display: flex; flex-direction: column; max-height: 85vh; }

  .vv-gal__modalTitle {
    background: #2d685f; color: #fff; font-size: 1.05rem; font-weight: 700;
    margin: 0; padding: .85rem 1.25rem;
    display: flex; align-items: center; gap: .5rem;
  }
  .vv-gal__modalTitle::before { content: "🖼️"; font-size: 1.1rem; }

  .vv-gal__modalDate {
    display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
    padding: .9rem 1.25rem; border-bottom: 1px solid #efe6dc; background: #faf7f3;
  }
  .vv-gal__modalDate label { font-size: .9rem; font-weight: 600; color: #2d685f; margin: 0; }
  .vv-gal__modalDate input { max-width: 170px; background: #fff; }

  .vv-gal__modalList {
    list-style: none; margin: 0; padding: 1rem 1.25rem;
    overflow-y: auto; display: flex; flex-direction: column; gap: .65rem;
    background: #fff;
  }
  .vv-gal__modalRow {
    display: flex; align-items: center; gap: 1rem;
    padding: .6rem; border: 1px solid #efe6dc; border-radius: .5rem;
    background: #faf7f3;
  }
  .vv-gal__modalThumb {
    width: 96px; height: 72px; flex: 0 0 96px;
    border-radius: .4rem; overflow: hidden; background: #fff;
    border: 1px solid #e4dbd0; display: grid; place-items: center; font-size: 1.7rem;
    box-shadow: 0 2px 6px rgba(20, 45, 40, .08);
  }
  .vv-gal__modalThumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vv-gal__modalMeta { flex: 1; min-width: 0; }
  .vv-gal__modalMeta label { font-size: .78rem; font-weight: 600; color: #55606d; display: block; margin-bottom: .2rem; }
  .vv-gal__modalMeta input { background: #fff; }
  .vv-gal__modalFile {
    font-size: .75rem; color: #8a9199; margin-top: .25rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .vv-gal__modalActions {
    display: flex; justify-content: flex-end; align-items: center; gap: .75rem;
    padding: .9rem 1.25rem; border-top: 1px solid #efe6dc; background: #faf7f3;
    border-radius: 0 0 .6rem .6rem;
  }
  /* « Annuler » : un vrai bouton visible, pas un lien gris pâle. */
  .vv-gal__modalActions [data-modal-cancel] {
    color: #55606d; font-weight: 600; text-decoration: none;
    border: 1px solid #c9c2b8; border-radius: .4rem; padding: .45rem 1rem;
    background: #fff; transition: background .15s ease, color .15s ease;
  }
  .vv-gal__modalActions [data-modal-cancel]:hover {
    background: #efe6dc; color: #211d18; border-color: #b3aa9e;
  }
  .vv-gal__modalActions .btn-primary { padding-inline: 1.5rem; font-weight: 600; }
</style>

{% endblock %}
